/.idea/*
misc/

# Deployment (do not commit real server configs)
/deploy/nginx/nginx.conf
/deploy/nginx/nginx.http-only.conf

# Environment files (DO NOT COMMIT SECRETS)
.env
.env.*
!*.example

# Also ignore env files inside subfolders (keep *.env.example)
**/.env
**/.env.*
!**/.env.example

# Runtime artifacts produced by the legacy daemon mode and systemd deploys
/bin/
/.backend-go-run.pid
/.backend-go-run.log
